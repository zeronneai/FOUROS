# Copy this file to .env and fill in real values (do not commit .env)

# --- 21st.dev Magic MCP server ---------------------------------------------
# Get yours at https://21st.dev/magic
MAGIC_API_KEY=

# --- Site config (exposed to the client via Vite) --------------------------
# WhatsApp number in international format, digits only (no + or spaces).
VITE_WHATSAPP_NUMBER=
# Instagram handle without the @.
VITE_INSTAGRAM_HANDLE=four_os_timepieces

# --- Supabase (optional) ----------------------------------------------------
# If unset, the contact form falls back to opening WhatsApp directly.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
